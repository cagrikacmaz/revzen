---
interface Props {
  num: string;
  eyebrow: string;
  headline: string;
  subhead?: string;
  id: string;
}
const { num, eyebrow, headline, subhead, id } = Astro.props;
---

<header class="section-head">
  <p class="eyebrow"><span class="eyebrow__num" aria-hidden="true">{num}</span>{eyebrow}</p>
  <h2 class="headline" id={`${id}-title`}>{headline}</h2>
  {subhead && <p class="subhead">{subhead}</p>}
  <slot />
</header>
