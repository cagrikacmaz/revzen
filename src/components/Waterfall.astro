---
interface Step {
  label: string;
  value: number;
  display: string;
  kind: string;
}
interface SumPart {
  text: string;
  kind: string;
}
interface Props {
  title: string;
  steps: Step[];
  sum: SumPart[];
  id: string;
}

const { title, steps, sum, id } = Astro.props;

// Hand-built waterfall: start total, negative steps, resulting contribution.
const W = 100;
const BAR = 58;
const TOP = 8;
const BOTTOM = 196;
const max = Math.max(...steps.map((s) => Math.abs(s.value)));
const y = (v: number) => BOTTOM - (v / max) * (BOTTOM - TOP);

let running = 0;
const bars = steps.map((s, i) => {
  let from: number;
  let to: number;
  if (s.kind === 'step') {
    from = running;
    to = running + s.value;
    running = to;
  } else {
    from = 0;
    to = s.value;
    running = s.value;
  }
  const top = y(Math.max(from, to));
  const height = Math.abs(y(from) - y(to));
  return { x: i * W + (W - BAR) / 2, top, height, level: running, kind: s.kind };
});
const desc = steps.map((s) => `${s.label} ${s.display}`).join(', ');
---

<figure class="waterfall card" aria-labelledby={`${id}-title`} style="margin:0">
  <h3 class="card-title" id={`${id}-title`}>{title}</h3>
  <svg
    viewBox={`0 0 ${steps.length * W} 200`}
    preserveAspectRatio="none"
    role="img"
    aria-label={desc}
    focusable="false"
  >
    <line class="wf-base" x1="0" x2={steps.length * W} y1={BOTTOM} y2={BOTTOM} vector-effect="non-scaling-stroke"></line>
    {
      bars.map((b, i) =>
        i < bars.length - 1 ? (
          <line
            class="wf-link"
            x1={b.x + BAR}
            x2={bars[i + 1].x}
            y1={y(b.level)}
            y2={y(b.level)}
            vector-effect="non-scaling-stroke"
          />
        ) : null,
      )
    }
    {
      bars.map((b) => (
        <rect class={`wf-${b.kind}`} x={b.x} y={b.top} width={BAR} height={Math.max(b.height, 1)} rx="2" />
      ))
    }
  </svg>
  <ol class="waterfall__labels" aria-hidden="true">
    {
      steps.map((s) => (
        <li>
          <strong class:list={{ 'is-negative': s.kind === 'step', 'is-positive': s.kind === 'result' }}>{s.display}</strong>
          <span>{s.label}</span>
        </li>
      ))
    }
  </ol>
  <p class="sum-line">
    {
      sum.map((p) => (
        <span class:list={{ 'is-minus': p.kind === 'minus', 'is-result': p.kind === 'result' }}>{p.text}</span>
      ))
    }
  </p>
</figure>
