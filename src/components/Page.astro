---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Wordmark from './Wordmark.astro';
import Hero from './sections/Hero.astro';
import Why from './sections/Why.astro';
import Product from './sections/Product.astro';
import Uses from './sections/Uses.astro';
import Market from './sections/Market.astro';
import Progress from './sections/Progress.astro';
import Ask from './sections/Ask.astro';
import Profit from './sections/Profit.astro';
import Calculator from './sections/Calculator.astro';
import Plan from './sections/Plan.astro';
import Terms from './sections/Terms.astro';
import Makers from './sections/Makers.astro';
import Next from './sections/Next.astro';
import { dicts, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dicts[lang];

// Eyebrow numbers follow the section order.
const n = (i: number) => String(i).padStart(2, '0');
---

<Base lang={lang}>
  <a class="skip-link" href="#main">{t.ui.skipToContent}</a>
  <Nav lang={lang} />
  <main id="main" tabindex="-1">
    <Hero t={t} />
    <Why t={t} />
    <Product t={t} num={n(1)} />
    <Uses t={t} num={n(2)} />
    <Market t={t} num={n(3)} />
    <Progress t={t} num={n(4)} />
    <Ask t={t} lang={lang} num={n(5)} />
    <Profit t={t} lang={lang} num={n(6)} />
    <Calculator t={t} lang={lang} num={n(7)} />
    <Plan t={t} num={n(8)} />
    <Terms t={t} num={n(9)} />
    <Makers t={t} num={n(10)} />
    <Next t={t} num={n(11)} />
  </main>
  <footer class="footer">
    <div class="wrap footer__inner">
      <Wordmark />
      <p>{t.footer.text}</p>
    </div>
  </footer>
</Base>
