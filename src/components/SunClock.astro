---
import type { Dict } from '../i18n';
import { sunState, sunStyle, styleString, formatTime, MIN_TIME, MAX_TIME } from '../lib/sun';

interface Props {
  t: Dict;
  id: string;
  variant: 'hero' | 'full';
}

const { t, id, variant } = Astro.props;
const s = t.sun;
const start = 480;
const initial = sunState(start);
const full = variant === 'full';

const toneName = { warm: s.toneWarm, neutral: s.toneNeutral, orange: s.toneOrange }[initial.tone];
const level = s.level.replace('{n}', String(Math.round(initial.level * 100)));
const dir = s.dirEast.replace('{deg}', String(Math.round(Math.abs(initial.angle))));
const valueText = s.valueText
  .replace('{time}', formatTime(start))
  .replace('{dir}', dir)
  .replace('{level}', level)
  .replace('{tone}', toneName);

const labels = {
  dirEast: s.dirEast,
  dirWest: s.dirWest,
  dirOverhead: s.dirOverhead,
  dirFixed: s.dirFixed,
  toneWarm: s.toneWarm,
  toneNeutral: s.toneNeutral,
  toneOrange: s.toneOrange,
  level: s.level,
  valueText: s.valueText,
  modeNoteColour: s.modeNoteColour,
  modeNoteDirectional: s.modeNoteDirectional,
};

const quick = t.product.states;
const ticks = [360, 480, 720, 1020, 1200];
---

<figure
  class:list={['sunclock', `sunclock--${variant}`]}
  data-sunclock
  data-mode="directional"
  data-labels={JSON.stringify(labels)}
  style={styleString(sunStyle(initial))}
  aria-label={s.figureLabel}
>
  <div class="sunclock__stage">
    <svg viewBox="0 0 640 400" role="img" aria-labelledby={`${id}-title ${id}-desc`} focusable="false">
      <title id={`${id}-title`}>{s.svgTitle}</title>
      <desc id={`${id}-desc`}>{s.svgDesc}</desc>
      <defs>
        <linearGradient id={`${id}-beam`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="sc-stop sc-stop--strong"></stop>
          <stop offset="1" class="sc-stop sc-stop--soft"></stop>
        </linearGradient>
        <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="sc-sky-top"></stop>
          <stop offset="1" class="sc-stop"></stop>
        </linearGradient>
        <radialGradient id={`${id}-patch`}>
          <stop offset="0" class="sc-stop"></stop>
          <stop offset="0.7" class="sc-stop sc-stop--mid"></stop>
          <stop offset="1" class="sc-stop sc-stop--none"></stop>
        </radialGradient>
        <radialGradient id={`${id}-halo`}>
          <stop offset="0" class="sc-stop"></stop>
          <stop offset="1" class="sc-stop sc-stop--none"></stop>
        </radialGradient>
        <linearGradient id={`${id}-shadow`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#02050b" stop-opacity="0.9"></stop>
          <stop offset="0.55" stop-color="#02050b" stop-opacity="0.75"></stop>
          <stop offset="1" stop-color="#02050b" stop-opacity="0"></stop>
        </linearGradient>
        <clipPath id={`${id}-panel`}>
          <rect x="180" y="14" width="280" height="34"></rect>
        </clipPath>
        <clipPath id={`${id}-room`}>
          <rect x="0" y="48" width="640" height="304"></rect>
        </clipPath>
      </defs>

      <rect class="sc-wall" x="0" y="0" width="640" height="400"></rect>
      <rect class="sc-ambient" x="0" y="48" width="640" height="304"></rect>

      <g clip-path={`url(#${id}-room)`}>
        <rect class="sc-beam" x="180" y="48" width="280" height="304" fill={`url(#${id}-beam)`}></rect>
      </g>

      <rect class="sc-floor" x="0" y="352" width="640" height="48"></rect>
      <line class="sc-floor-line" x1="0" y1="352" x2="640" y2="352"></line>
      <ellipse class="sc-patch" cx="320" cy="353" rx="150" ry="9" fill={`url(#${id}-patch)`}></ellipse>
      <rect class="sc-shadow" x="320" y="348" width="1" height="9" fill={`url(#${id}-shadow)`}></rect>
      <ellipse class="sc-contact" cx="320" cy="353" rx="30" ry="3.5"></ellipse>

      <g class="sc-plant">
        <path class="sc-leaf" d="M320 300 C 300 280, 282 262, 268 246 C 292 250, 312 266, 320 300 Z"></path>
        <path class="sc-leaf sc-leaf--light" d="M320 300 C 338 276, 356 258, 372 250 C 360 274, 340 290, 320 300 Z"></path>
        <path class="sc-leaf" d="M320 302 C 316 276, 318 258, 324 242 C 334 262, 330 282, 320 302 Z"></path>
        <path class="sc-leaf sc-leaf--light" d="M320 304 C 304 292, 290 286, 276 284 C 292 300, 306 304, 320 304 Z"></path>
        <path class="sc-leaf" d="M320 304 C 336 294, 350 290, 364 290 C 350 304, 334 306, 320 304 Z"></path>
        <path class="sc-pot" d="M292 312 H348 L342 352 H298 Z"></path>
        <rect class="sc-pot-rim" x="288" y="306" width="64" height="8" rx="2"></rect>
      </g>

      <rect class="sc-ceiling" x="0" y="0" width="640" height="48"></rect>
      <g clip-path={`url(#${id}-panel)`}>
        <rect class="sc-sky" x="180" y="14" width="280" height="34" fill={`url(#${id}-sky)`}></rect>
        <g class="sc-sun">
          <circle cx="320" cy="31" r="26" fill={`url(#${id}-halo)`}></circle>
          <circle class="sc-sun-core" cx="320" cy="31" r="9"></circle>
        </g>
      </g>
      <rect class="sc-frame" x="180" y="14" width="280" height="34"></rect>
      <line class="sc-ceiling-line" x1="0" y1="48" x2="640" y2="48"></line>
    </svg>
  </div>

  <div class="sunclock__controls">
    <div class="sunclock__row">
      <label class="sunclock__label" for={`${id}-time`}>{s.sliderLabel}</label>
      <output class="sunclock__time" for={`${id}-time`} data-sc-time>{formatTime(start)}</output>
    </div>
    <input
      class="sunclock__range"
      type="range"
      id={`${id}-time`}
      min={MIN_TIME}
      max={MAX_TIME}
      step="15"
      value={start}
      aria-valuetext={valueText}
      data-sc-range
    />
    <div class="sunclock__ticks" aria-hidden="true">
      {ticks.map((m) => <span style={`--pos:${(m - MIN_TIME) / (MAX_TIME - MIN_TIME)}`}>{formatTime(m)}</span>)}
    </div>

    {
      full ? (
        <div class="sunclock__states" role="group" aria-label={t.product.statesLabel}>
          {quick.map((st) => (
            <button type="button" class="state" data-sc-jump={st.minutes} aria-pressed={st.minutes === start ? 'true' : 'false'}>
              <span class="state__time">{st.time}</span>
              <span class="state__name">{st.name}</span>
              <span class="state__row">
                <span class="state__key">{t.product.stateDirection}</span>
                <span>{st.direction}</span>
              </span>
              <span class="state__row">
                <span class="state__key">{t.product.stateLevel}</span>
                <span>{st.level}</span>
              </span>
              <span class="state__row">
                <span class="state__key">{t.product.stateTone}</span>
                <span>{st.tone}</span>
              </span>
            </button>
          ))}
        </div>
      ) : (
        <div class="sunclock__quick" role="group" aria-label={s.quickLabel}>
          {quick.map((st) => (
            <button type="button" class="chip" data-sc-jump={st.minutes} aria-pressed={st.minutes === start ? 'true' : 'false'}>
              {st.time}
            </button>
          ))}
          <button type="button" class="chip chip--ghost" data-sc-play>
            {s.play}
          </button>
        </div>
      )
    }

    {
      full && (
        <div class="sunclock__compare">
          <fieldset class="segmented">
            <legend class="segmented__legend">{s.modeLegend}</legend>
            <label>
              <input type="radio" name={`${id}-mode`} value="colour" data-sc-mode />
              <span>{s.modeColour}</span>
            </label>
            <label>
              <input type="radio" name={`${id}-mode`} value="directional" data-sc-mode checked />
              <span>{s.modeDirectional}</span>
            </label>
          </fieldset>
          <p class="sunclock__note" data-sc-note>{s.modeNoteDirectional}</p>
          <dl class="readout">
            <div>
              <dt>{s.readTime}</dt>
              <dd data-sc-read="time">{formatTime(start)}</dd>
            </div>
            <div>
              <dt>{s.readDirection}</dt>
              <dd data-sc-read="dir">{dir}</dd>
            </div>
            <div>
              <dt>{s.readLevel}</dt>
              <dd data-sc-read="level">{level}</dd>
            </div>
            <div>
              <dt>{s.readTone}</dt>
              <dd data-sc-read="tone">{toneName}</dd>
            </div>
          </dl>
          <button type="button" class="chip chip--ghost" data-sc-play>
            {s.play}
          </button>
        </div>
      )
    }
  </div>

  <figcaption class="caption">{t.ui.conceptCaption}</figcaption>
</figure>

<script>
  import { initSunClocks } from '../scripts/sunclock';
  initSunClocks();
</script>
