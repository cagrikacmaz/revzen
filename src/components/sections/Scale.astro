---
import SectionHead from '../SectionHead.astro';
import Metrics from '../Metrics.astro';
import Waterfall from '../Waterfall.astro';
import type { Dict } from '../../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const s = t.scale;
---

<section class="section" id="scale" data-section data-nav-group="model" aria-labelledby="scale-title">
  <div class="wrap">
    <SectionHead id="scale" num="07" eyebrow={s.eyebrow} headline={s.headline} subhead={s.subhead} />
    <Metrics items={s.metrics} />
    <div class="model__grid">
      <Waterfall id="bridge-10000" title={s.bridgeTitle} steps={s.bridge} sum={s.bridgeSum} />
      <aside class="callout callout--coral" aria-labelledby="capital-title">
        <h3 class="callout__title" id="capital-title">{s.capitalTitle}</h3>
        <p>{s.capitalText}</p>
      </aside>
    </div>
  </div>
</section>
