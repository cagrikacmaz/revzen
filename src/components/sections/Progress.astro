---
import SectionHead from '../SectionHead.astro';
import type { Dict } from '../../i18n';

interface Props {
  t: Dict;
  num: string;
}
const { t, num } = Astro.props;
const p = t.progress;
const statusLabel: Record<string, string> = {
  done: p.statusDone,
  current: p.statusCurrent,
  upcoming: p.statusUpcoming,
};
---

<section class="section" id="progress" data-section data-nav-group="progress" aria-labelledby="progress-title">
  <div class="wrap">
    <SectionHead id="progress" num={num} eyebrow={p.eyebrow} headline={p.headline} subhead={p.subhead} />
    <ol class="stepper" aria-label={p.listLabel}>
      {
        p.steps.map((s, i) => (
          <li class:list={['step', `step--${s.status}`]} aria-current={s.status === 'current' ? 'step' : undefined}>
            <span class="step__marker" aria-hidden="true">
              {s.status === 'done' ? (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M7 12.5l3.2 3.2L17 9" />
                </svg>
              ) : (
                <span class="step__num">{i + 1}</span>
              )}
            </span>
            <span class="step__body">
              <span class="step__status">{statusLabel[s.status]}</span>
              <span class="step__title">{s.title}</span>
              {s.detail && <span class="step__detail">{s.detail}</span>}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
