---
import SectionHead from '../SectionHead.astro';
import type { Dict } from '../../i18n';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const c = t.category;
---

<section class="section" id="category" data-section data-nav-group="category" aria-labelledby="category-title">
  <div class="wrap">
    <SectionHead id="category" num="02" eyebrow={c.eyebrow} headline={c.headline} subhead={c.subhead} />
    <div class="table-wrap">
      <table class="table table--cards">
        <caption>{c.tableCaption}</caption>
        <thead>
          <tr>{c.columns.map((col) => <th scope="col">{col}</th>)}</tr>
        </thead>
        <tbody>
          {
            c.rows.map((r) => (
              <tr class:list={{ 'row--highlight': r.highlight }}>
                <th scope="row">{r.cells[0]}</th>
                {r.cells.slice(1).map((cell, i) => (
                  <td data-label={c.columns[i + 1]}>{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="note">{c.footnote}</p>
  </div>
</section>
