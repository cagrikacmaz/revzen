---
import type { Dict } from '../../i18n';
import { whatsappUrl } from '../../lib/contact';

interface Props {
  t: Dict;
  deckHref: string | null;
}
const { t, deckHref } = Astro.props;
const n = t.next;
---

<section class="section next" id="next" data-section data-nav-group="terms" aria-labelledby="next-title">
  <div class="wrap">
    <p class="eyebrow"><span class="eyebrow__num" aria-hidden="true">13</span>{n.eyebrow}</p>
    <h2 class="headline next__line" id="next-title">{n.line}</h2>
    <ol class="flow next__flow" aria-label={n.stepsLabel}>
      {
        n.steps.map((s, i) => (
          <>
            {i > 0 && (
              <li class="arrow" aria-hidden="true">
                →
              </li>
            )}
            <li>{s}</li>
          </>
        ))
      }
    </ol>
    <div class="next__actions">
      <a class="btn btn--primary" href={whatsappUrl(t.ui.whatsappMessage)} target="_blank" rel="noopener">
        {t.ui.whatsappCta}
        <span class="visually-hidden">{t.ui.opensInNewTab}</span>
      </a>
      {
        deckHref && (
          <a class="btn btn--ghost" href={deckHref} download>
            {t.ui.downloadDeckPdf}
          </a>
        )
      }
    </div>
  </div>
</section>
